{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "tsconfig": "tsconfig.json",
  "name": "playcanvas-opti-pixel",
  "includeVersion": true,
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "hostedBaseUrl": "https://alexappi.github.io/playcanvas-opti-pixel/",
  "exclude": [
    "**/*.test.ts",
    "**/*.todo.ts"
  ],
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  }
}
